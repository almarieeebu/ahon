# Copy this file to `.env.local` and fill in values from Supabase → Project Settings → API
#
# NEXT_PUBLIC_ = safe to expose in the browser (anon / publishable key only — NEVER the service_role / secret key)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Either name works (Supabase UI may label this "anon" or "publishable"):
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
